# Ana Dépôt web — environment configuration. Copy to .env.local and fill in; NEVER commit real values.
# Next.js loads .env.local automatically. Only NEXT_PUBLIC_* values reach the browser.

# --- Supabase Auth (public values; safe in the browser) ---------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co  (local Supabase CLI stack: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# The project's PUBLIC key. Use ONE of the two names (the newer "publishable" key wins if both are set).
# This is NOT the service-role / secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Ana Dépôt API (Spring Boot) --------------------------------------------------------------------------------
# Public base URL the BROWSER may call (the typed API client). No trailing slash. Example: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=
# Optional server-only override used by Server Components (e.g. an internal network address). Falls back to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=

# The API must list THIS web origin in its ANA_CORS_ALLOWED_ORIGINS (the browser calls it directly).

# --- Reservation terms (the business supplies the label and the text; see docs/storefront-integration.md) -------------------
# Label of the terms in force. MUST equal the API's ANA_TERMS_VERSION. Empty = reservations cannot be sent (nobody can accept terms that do not exist).
NEXT_PUBLIC_TERMS_VERSION=
# Optional: where the published terms live (a path such as /info/terms, or an https:// URL).
NEXT_PUBLIC_TERMS_URL=

# The service-role / secret key is deliberately NOT a variable of this app: the browser app never needs it and must never see it.
